{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "revert", "section": "Reverts" },
    { "type": "web", "section": "Web" },
    { "type": "server", "section": "Server" },
    { "type": "firmware", "section": "Firmware" },
    { "type": "hassio", "section": "Home Assistant" },
    { "type": "build", "section": "Build" },
    { "type": "docs", "section": "Documentation" },
    { "type": "ci", "section": "Continuous Integration" },
    { "type": "chore", "section": "Chores" }
  ],
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "paperloom",
      "components": ["paperloom-web", "paperloom-hassio"]
    }
  ],
  "packages": {
    "server/web": {
      "release-type": "node",
      "package-name": "paperloom-web",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "server/web/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "hassio": {
      "release-type": "simple",
      "package-name": "paperloom-hassio",
      "changelog-path": "CHANGELOG.md",
      "version-file": "version.txt",
      "extra-files": [
        {
          "type": "yaml",
          "path": "config.yaml",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
