# Paperloom firmware defaults for the ESP32-133C02 (ESP32-S3 with PSRAM).

CONFIG_IDF_TARGET="esp32s3"

# --- Flash and partitioning -------------------------------------------
# The ESP32-S3 module on this board is the N16R8 variant: 16 MB of flash
# and 8 MB of PSRAM.
#
# The flash mode and frequency matter more than they look. The chip's
# eFuse records that the flash is quad, so the ROM boots in QIO, but this
# particular flash chip is not reliable at 80 MHz in quad mode: the image
# gets corrupted during load and the ROM dies in its loader with
# "ets_loader_map_range", showing as a boot loop with no output.
#
# DIO at 40 MHz is the safe combination, and it boots reliably.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM -----------------------------------------------------------
# The frame buffer is 960,000 bytes and cannot fit in internal RAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# --- CPU and power ----------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# --- Wi-Fi ------------------------------------------------------------
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y

# --- TLS --------------------------------------------------------------
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y

# --- Filesystem -------------------------------------------------------
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_CODEPAGE_437=y

# --- Logging ----------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# --- The clock that keeps time while the frame is asleep --------------------
# The frame spends nearly all its life asleep, and it is woken by a timer on
# the slow clock. The slow clock has to be the one the timer is told to
# count, or the frame wakes at the wrong time.
#
# The default is the 150 kHz internal RC oscillator, whose frequency drifts
# with temperature and which the timer does not measure accurately. The
# 8 MHz oscillator divided by 256 gives about 33 kHz, is far steadier, and
# is what the wake-up timer counts against.
#
# The board has no 32 kHz crystal, so this is the best of what it has.
# The internal 150 kHz RC oscillator is what the reference project for
# this board uses, and the wake-up timer counts against it correctly.
#
# The 8 MHz oscillator divided by 256 is steadier, but the chip switches
# the slow clock to it only for the duration of the sleep, and the timer
# is set against the frequency measured before that switch, so the frame
# wakes at the wrong time.
CONFIG_RTC_CLK_SRC_INT_RC=y
# CONFIG_RTC_CLK_SRC_EXT_CRYS is not set
# CONFIG_RTC_CLK_SRC_EXT_OSC is not set
# CONFIG_RTC_CLK_SRC_INT_8MD256 is not set

# --- Console -------------------------------------------------------------
# The console is the UART on GPIO43/44, which is what the CH340 on the
# board is wired to.
#
# There is no secondary console. The secondary console would be the
# USB-Serial-JTAG port, and choosing it would switch the USB-Serial-JTAG
# module on: it cannot be turned off while the secondary console is that
# port.
#
# The board does not use the chip's native USB, and with the module
# enabled its connection monitor assumes a host is present and keeps the
# 48 MHz clock running, which costs power and gets in the way of a
# proper deep sleep.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
# CONFIG_USJ_ENABLE_USB_SERIAL_JTAG is not set

# --- Watchdog ---------------------------------------------------------
# The task watchdog is off.
#
# The wake-up timer in the deep sleep is armed by the chip itself, and the
# task watchdog fights with it: the frame wakes early, the watchdog has
# not been fed, and the chip is reset. The IDF's own deep-sleep test
# turns the task watchdog off for the same reason.
CONFIG_ESP_TASK_WDT_EN=n
# CONFIG_ESP_TASK_WDT_INIT is not set

# A deep-sleep wake is close to a reboot, and the Wi-Fi connect can take a
# while. Give the task watchdog enough room.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# --- Compiler ---------------------------------------------------------
# The build is not optimised for size or speed.
#
# The frame's deep sleep depends on the wake stub and the RTC's fast
# memory, and those only behave properly in a debug build. An optimised
# build leaves the frame waking after a fixed moment, whatever time it
# was asked to sleep for.
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y
CONFIG_COMPILER_OPTIMIZATION_LEVEL_DEBUG=y

# --- Task stacks ------------------------------------------------------
# The default 3584-byte main task stack is not enough for this firmware:
# app_main parses JSON, hashes bodies and brings up the HTTP client, all
# of which nest several frames deep. The reference project uses 6144 for
# the same reason.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
