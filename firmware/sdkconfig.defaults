# Paperloom firmware defaults for the ESP32-133C02 (ESP32-S3 with PSRAM).

CONFIG_IDF_TARGET="esp32s3"

# --- Flash and partitioning -------------------------------------------
# The ESP32-S3 module on this board is the N16R8 variant: 16 MB of flash
# and 8 MB of PSRAM.
#
# The flash mode and frequency matter more than they look. The chip's
# eFuse records that the flash is quad, so the ROM boots in QIO, but this
# particular flash chip is not reliable at 80 MHz in quad mode: the image
# gets corrupted during load and the ROM dies in its loader with
# "ets_loader_map_range", showing as a boot loop with no output.
#
# DIO at 40 MHz is the safe combination, and it boots reliably.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM -----------------------------------------------------------
# The frame buffer is 960,000 bytes and cannot fit in internal RAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# --- CPU and power ----------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# --- Wi-Fi ------------------------------------------------------------
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y

# --- TLS --------------------------------------------------------------
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y

# --- Filesystem -------------------------------------------------------
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_CODEPAGE_437=y

# --- Logging ----------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# --- Watchdog ---------------------------------------------------------
# A deep-sleep wake is close to a reboot, and the Wi-Fi connect can take a
# while. Give the task watchdog enough room.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# --- Compiler ---------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Task stacks ------------------------------------------------------
# The default 3584-byte main task stack is not enough for this firmware:
# app_main parses JSON, hashes bodies and brings up the HTTP client, all
# of which nest several frames deep. The reference project uses 6144 for
# the same reason.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
