{
  "name": "paperloom-server",
  "version": "0.1.0",
  "private": true,
  "description": "Paperloom server: galleries, scheduling policy, asset rendering, device sync API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm run build:web",
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/panel.test.ts src/panel-layout.test.ts src/image.test.ts src/auth/signing.test.ts src/schedule/materialize.test.ts src/schedule/rules.test.ts src/api/device.test.ts src/api/integration.test.ts",
    "migrate": "tsx src/db/migrate.ts",
    "preview": "tsx src/tools/preview.ts",
    "live-check": "tsx src/tools/live-check.ts",
    "build:web": "npm --prefix web run build",
    "postinstall": "node scripts/build-web.mjs"
  },
  "workspaces": [
    "web"
  ],
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.1.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^8.0.2",
    "@fastify/multipart": "^9.0.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
