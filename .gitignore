# The build script records the ESP-IDF environment it used, so that the
# interpreter does not change between builds.
firmware/.paperloom-env.json

# Scratch files from reading the flash on the device.
firmware/nvs*.bin
firmware/otadata*.bin
firmware/pt.bin
firmware/app-*.bin

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
