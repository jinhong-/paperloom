# Node
node_modules/
dist/
*.tsbuildinfo

# Server runtime data (database, asset store)
data/
*.log
.env
.env.local

# ESP-IDF build output
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
